};

&sdhci {
        bus-width = <8>;
        supports-emmc;
        non-removable;
        max-frequency = <200000000>;
        status = "okay";
};

&sdmmc0 {
        max-frequency = <150000000>;
        supports-sd;
        bus-width = <4>;
        cap-mmc-highspeed;
        cap-sd-highspeed;
        disable-wp;
        sd-uhs-sdr104;
        vmmc-supply = <&vcc3v3_sd>;
        vqmmc-supply = <&vccio_sd>;
        pinctrl-names = "default";
        pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
        status = "okay";
};

